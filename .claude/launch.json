{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "docs-server",
      "runtimeExecutable": "node",
      "runtimeArgs": ["-e", "const h=require('http'),f=require('fs'),p=require('path');const t={'.html':'text/html','.png':'image/png','.json':'application/json'};h.createServer((q,r)=>{const u=p.join('docs',decodeURIComponent(q.url.split('?')[0]));f.readFile(u,(e,d)=>{if(e){r.writeHead(404);return r.end()}r.writeHead(200,{'Content-Type':t[p.extname(u)]||'application/octet-stream'});r.end(d)})}).listen(8765)"],
      "port": 8765
    }
  ]
}
